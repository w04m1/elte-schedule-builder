# Override the repository used by the GitHub star buttons.
VITE_GITHUB_REPOSITORY_URL=https://github.com/unnobatroo/elte-schedule-builder

# Local server ports. The Vite proxy follows PORT unless an explicit remote or
# container API target is needed.
PORT=3000
VITE_DEV_SERVER_PORT=5173
# VITE_API_PROXY_TARGET=http://localhost:3000

# The production container sets this automatically. Set it explicitly when
# running a non-container production deployment so HTTPS responses include HSTS.
# NODE_ENV=production

# Backend safeguards. Defaults are shown here for production tuning.
MAX_CACHE_ENTRIES=1000
MAX_QUEUE_LENGTH=100
SUBJECT_RATE_LIMIT=60
UPSTREAM_TIMEOUT_MS=10000

# Enable verbose backend request, queue, and cache diagnostics.
# DEBUG_SERVER=true

# Override the SQLite cache location. Tests can use :memory: to avoid files.
# CACHE_DB_PATH=./data/cache.db

# Set only when the app is behind exactly one trusted reverse proxy.
# TRUST_PROXY_HOPS=1
