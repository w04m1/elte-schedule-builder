{
  "name": "elte-schedule-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "npm run format:check && npm run lint"
  },
  "overrides": {
    "brace-expansion@^1.0.0": "1.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "^5.2.3",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.15.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@preact/signals": "^2.9.4",
    "@schedule-x/calendar": "^3.7.3",
    "@schedule-x/event-modal": "^3.7.3",
    "@schedule-x/events-service": "^3.7.3",
    "@schedule-x/svelte": "^3.0.0",
    "@schedule-x/theme-default": "^3.7.3",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "preact": "^10.29.7",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "temporal-polyfill": "^0.3.0"
  },
  "allowScripts": {
    "esbuild@0.25.9": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": false,
    "sqlite3@6.0.1": true
  }
}
